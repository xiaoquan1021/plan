{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XQ Codex A Epic Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "epic_id",
    "epic_contract_sha256",
    "review_base_commit",
    "review_head_commit",
    "required_outcomes",
    "architecture_constraints",
    "acceptance_evidence",
    "cross_task_integration_findings",
    "unresolved_risks",
    "contract_defects",
    "decision",
    "required_repairs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "epic_id": { "type": "string", "minLength": 1 },
    "epic_contract_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "review_base_commit": { "type": ["string", "null"] },
    "review_head_commit": { "type": ["string", "null"] },
    "required_outcomes": { "type": "array", "items": { "type": "string" } },
    "architecture_constraints": { "type": "array", "items": { "type": "string" } },
    "acceptance_evidence": { "type": "array", "items": { "type": "string" } },
    "cross_task_integration_findings": { "type": "array", "items": { "type": "string" } },
    "unresolved_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "description", "owner"],
        "properties": {
          "severity": { "enum": ["blocking", "non-blocking"] },
          "description": { "type": "string", "minLength": 1 },
          "evidence": { "type": ["string", "null"] },
          "follow_up": { "type": ["string", "null"] },
          "owner": { "type": "string", "minLength": 1 },
          "non_blocking_rationale": { "type": ["string", "null"] }
        },
        "anyOf": [
          { "required": ["evidence"] },
          { "required": ["follow_up"] }
        ],
        "allOf": [
          {
            "if": { "properties": { "severity": { "const": "non-blocking" } } },
            "then": {
              "properties": {
                "non_blocking_rationale": { "type": "string", "minLength": 1 }
              },
              "required": ["non_blocking_rationale"]
            }
          }
        ]
      }
    },
    "contract_defects": { "type": "array", "items": { "type": "string" } },
    "decision": { "enum": ["accepted", "repair-required", "contract-defect", "blocked"] },
    "required_repairs": { "type": "array", "items": { "type": "string" } },
    "dependency_lock_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "toolchain_manifest_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "accepted" } } },
      "then": {
        "properties": {
          "epic_contract_sha256": { "type": "string", "minLength": 64 },
          "review_base_commit": { "type": "string", "minLength": 7 },
          "review_head_commit": { "type": "string", "minLength": 7 },
          "required_outcomes": { "type": "array", "minItems": 1 },
          "architecture_constraints": { "type": "array", "minItems": 1 },
          "acceptance_evidence": { "type": "array", "minItems": 1 },
          "unresolved_risks": {
            "type": "array",
            "not": {
              "contains": {
                "type": "object",
                "properties": { "severity": { "const": "blocking" } },
                "required": ["severity"]
              }
            }
          },
          "contract_defects": { "type": "array", "maxItems": 0 },
          "required_repairs": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ]
}
