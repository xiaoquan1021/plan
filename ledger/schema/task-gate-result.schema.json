{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XQ Codex B Task Gate Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_pack_sha256",
    "epic_contract_sha256",
    "base_commit",
    "result_commit",
    "changed_files",
    "allowed_path_check",
    "workspace_clean_before",
    "workspace_clean_after",
    "commands_reexecuted",
    "exit_codes",
    "tests_observed",
    "test_integrity_check",
    "forbidden_scan",
    "result_artifact_hashes",
    "decision",
    "rework_reason",
    "escalation_reason"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "task_pack_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "epic_contract_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "base_commit": { "type": ["string", "null"] },
    "result_commit": { "type": ["string", "null"] },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "allowed_path_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "violations"],
      "properties": {
        "passed": { "type": "boolean" },
        "violations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "workspace_clean_before": { "type": ["boolean", "null"] },
    "workspace_clean_after": { "type": ["boolean", "null"] },
    "commands_reexecuted": { "type": "array", "items": { "type": "string" } },
    "exit_codes": { "type": "array", "items": { "type": "integer" } },
    "tests_observed": { "type": "array", "items": { "type": "string" } },
    "test_integrity_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "notes"],
      "properties": {
        "passed": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "forbidden_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "findings"],
      "properties": {
        "passed": { "type": "boolean" },
        "findings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "result_artifact_hashes": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "decision": { "enum": ["accepted", "rework", "escalated", "rejected"] },
    "rework_reason": { "type": ["string", "null"] },
    "escalation_reason": { "type": ["string", "null"] },
    "dependency_contract_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "implementation_dependency_lock_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "dependency_lock_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "toolchain_manifest_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "accepted" } } },
      "then": {
        "properties": {
          "task_pack_sha256": { "type": "string", "minLength": 64 },
          "epic_contract_sha256": { "type": "string", "minLength": 64 },
          "base_commit": { "type": "string", "minLength": 7 },
          "result_commit": { "type": "string", "minLength": 7 },
          "changed_files": { "type": "array", "minItems": 1 },
          "allowed_path_check": {
            "type": "object",
            "properties": {
              "passed": { "const": true },
              "violations": { "type": "array", "maxItems": 0 }
            }
          },
          "workspace_clean_before": { "const": true },
          "workspace_clean_after": { "const": true },
          "commands_reexecuted": { "type": "array", "minItems": 1 },
          "exit_codes": { "type": "array", "minItems": 1, "items": { "const": 0 } },
          "tests_observed": { "type": "array", "minItems": 1 },
          "test_integrity_check": {
            "type": "object",
            "properties": { "passed": { "const": true } }
          },
          "forbidden_scan": {
            "type": "object",
            "properties": {
              "passed": { "const": true },
              "findings": { "type": "array", "maxItems": 0 }
            }
          },
          "result_artifact_hashes": { "type": "array", "minItems": 1 },
          "rework_reason": { "type": "null" },
          "escalation_reason": { "type": "null" }
        }
      }
    }
  ]
}
