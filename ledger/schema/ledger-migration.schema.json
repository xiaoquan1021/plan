{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XQ Ledger Migration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "migration_id", "description", "legacy_input", "rules", "mappings"],
  "properties": {
    "schema_version": { "const": 1 },
    "migration_id": { "type": "string" },
    "description": { "type": "string" },
    "legacy_input": { "type": "string" },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_completed_inherits_implementation_completion",
        "original_events_are_not_modified",
        "original_completion_records_are_not_modified"
      ],
      "properties": {
        "legacy_completed_inherits_implementation_completion": { "const": false },
        "original_events_are_not_modified": { "const": true },
        "original_completion_records_are_not_modified": { "const": true }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "old_task_id",
          "old_source",
          "new_task_ids",
          "new_milestone",
          "new_epic",
          "status_rule",
          "superseded_by",
          "reason"
        ],
        "properties": {
          "old_task_id": { "type": "string" },
          "old_source": { "type": "string" },
          "new_task_ids": { "type": "array", "items": { "type": "string" } },
          "new_milestone": { "type": "string" },
          "new_epic": { "type": "string" },
          "status_rule": {
            "enum": [
              "mapped",
              "superseded",
              "historical-only",
              "unmapped",
              "requires-private-reconciliation",
              "stale-completion"
            ]
          },
          "superseded_by": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
