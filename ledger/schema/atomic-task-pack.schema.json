{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XQ Atomic Task Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "task_id",
    "epic_id",
    "issuance_status",
    "execution_ready",
    "baseline_requirement",
    "base_commit",
    "rollback_point",
    "worktree_binding",
    "epic_contract_sha256",
    "task_pack_sha256",
    "dependency_contract_sha256",
    "implementation_dependency_lock_path",
    "implementation_dependency_lock_sha256",
    "toolchain_manifest_sha256",
    "supersedes",
    "allowed_logical_scopes",
    "allowed_paths",
    "forbidden_actions",
    "commands",
    "machine_acceptance",
    "required_evidence",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_version": { "type": "integer", "minimum": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "epic_id": { "type": "string", "minLength": 1 },
    "issuance_status": { "enum": ["draft", "issued", "revoked", "stale"] },
    "execution_ready": { "type": "boolean" },
    "baseline_requirement": { "type": "string", "minLength": 1 },
    "base_commit": { "type": ["string", "null"] },
    "rollback_point": { "type": ["string", "null"] },
    "worktree_binding": { "type": ["string", "null"] },
    "epic_contract_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "task_pack_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "dependency_contract_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "implementation_dependency_lock_path": { "type": "string", "minLength": 1 },
    "implementation_dependency_lock_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "toolchain_manifest_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "allowed_logical_scopes": { "type": "array", "items": { "type": "string" } },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "required"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "machine_acceptance": { "type": "array", "items": { "type": "string" } },
    "required_evidence": { "type": "array", "items": { "type": "string" } },
    "stop_conditions": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "issuance_status": { "const": "draft" } } },
      "then": {
        "properties": {
          "execution_ready": { "const": false },
          "base_commit": { "type": "null" },
          "rollback_point": { "type": "null" },
          "worktree_binding": { "type": "null" },
          "task_pack_sha256": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "issuance_status": { "const": "issued" } } },
      "then": {
        "properties": {
          "execution_ready": { "const": true },
          "base_commit": { "type": "string", "minLength": 7 },
          "rollback_point": { "type": "string", "minLength": 1 },
          "worktree_binding": { "type": "string", "minLength": 1 },
          "epic_contract_sha256": { "type": "string", "minLength": 64 },
          "task_pack_sha256": { "type": "string", "minLength": 64 },
          "dependency_contract_sha256": { "type": "string", "minLength": 64 },
          "implementation_dependency_lock_sha256": { "type": "string", "minLength": 64 },
          "toolchain_manifest_sha256": { "type": "string", "minLength": 64 },
          "allowed_paths": { "type": "array", "minItems": 1 },
          "commands": { "type": "array", "minItems": 1 },
          "machine_acceptance": { "type": "array", "minItems": 1 },
          "required_evidence": { "type": "array", "minItems": 1 },
          "stop_conditions": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
