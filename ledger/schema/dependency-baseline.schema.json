{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XQ Proposed Dependency Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "verification_status", "implementation_dependency_lock_path", "dependencies", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_version": { "type": "integer", "minimum": 1 },
    "verification_status": { "type": "string" },
    "implementation_dependency_lock_path": { "type": "string" },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "suggested_version",
          "official_source",
          "sha256",
          "license",
          "compiler_abi",
          "build_options",
          "role_in_xq",
          "allowed_in_public_api",
          "runtime_packaging",
          "verification_status",
          "owner",
          "required_evidence",
          "alternatives",
          "compatibility_constraints",
          "licensing_status",
          "expected_decision_milestone"
        ],
        "properties": {
          "name": { "type": "string" },
          "suggested_version": { "type": "string" },
          "official_source": { "type": "string" },
          "sha256": { "type": "string" },
          "license": { "type": "string" },
          "compiler_abi": { "type": "string" },
          "build_options": { "type": "object" },
          "role_in_xq": { "type": "string" },
          "allowed_in_public_api": { "type": "boolean" },
          "runtime_packaging": { "type": "string" },
          "verification_status": { "type": "string" },
          "owner": { "type": "string" },
          "required_evidence": { "type": "array", "items": { "type": "string" } },
          "alternatives": { "type": "array", "items": { "type": "string" } },
          "compatibility_constraints": { "type": "array", "items": { "type": "string" } },
          "licensing_status": { "type": "string" },
          "expected_decision_milestone": { "type": "string" }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed_baseline_is_not_implementation_lock",
        "implementation_lock_must_live_in",
        "mismatch_requires_codex_a_escalation"
      ],
      "properties": {
        "proposed_baseline_is_not_implementation_lock": { "const": true },
        "implementation_lock_must_live_in": { "type": "string" },
        "mismatch_requires_codex_a_escalation": { "const": true }
      }
    }
  }
}
