{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XQ Codex A Epic Contract Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "epic_id",
    "epic_contract_sha256",
    "reviewer_role",
    "reviewed_at",
    "decision",
    "architecture_findings",
    "unresolved_decisions",
    "required_repairs",
    "approval_record_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "epic_id": { "type": "string", "minLength": 1 },
    "epic_contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewer_role": { "const": "Codex A" },
    "reviewed_at": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["approved", "repair-required", "rejected", "blocked"] },
    "architecture_findings": { "type": "array", "items": { "type": "string" } },
    "unresolved_decisions": { "type": "array", "items": { "type": "string" } },
    "required_repairs": { "type": "array", "items": { "type": "string" } },
    "approval_record_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "approved" } } },
      "then": {
        "properties": {
          "architecture_findings": { "type": "array", "minItems": 1 },
          "unresolved_decisions": { "type": "array", "maxItems": 0 },
          "required_repairs": { "type": "array", "maxItems": 0 },
          "approval_record_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  ]
}
