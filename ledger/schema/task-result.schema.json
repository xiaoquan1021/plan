{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XQ Task Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_pack_sha256",
    "epic_contract_sha256",
    "base_commit",
    "result_commit",
    "changed_files",
    "commands_run",
    "test_results",
    "artifacts",
    "unresolved_issues",
    "decision_request"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "task_pack_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "epic_contract_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "base_commit": { "type": ["string", "null"] },
    "result_commit": { "type": ["string", "null"] },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "commands_run": { "type": "array", "items": { "type": "string" } },
    "test_results": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "unresolved_issues": { "type": "array", "items": { "type": "string" } },
    "decision_request": { "enum": ["gate-required", "blocked", "escalation-required"] },
    "decision": { "enum": ["completed", "gate-required", "ready-for-gate", "passed"] },
    "overall_status": { "enum": ["passed", "completed", "failed", "blocked"] },
    "dependency_lock_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "toolchain_manifest_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "properties": { "decision": { "enum": ["completed", "passed"] } }, "required": ["decision"] },
          { "properties": { "overall_status": { "enum": ["completed", "passed"] } }, "required": ["overall_status"] }
        ]
      },
      "then": {
        "required": ["dependency_lock_sha256", "toolchain_manifest_sha256"],
        "properties": {
          "task_pack_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "epic_contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "base_commit": { "type": "string", "minLength": 7 },
          "result_commit": { "type": "string", "minLength": 7 },
          "changed_files": { "type": "array", "minItems": 1 },
          "commands_run": { "type": "array", "minItems": 1 },
          "test_results": { "type": "array", "minItems": 1 },
          "artifacts": { "type": "array", "minItems": 1 },
          "unresolved_issues": { "type": "array", "maxItems": 0 },
          "dependency_lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "toolchain_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  ]
}
